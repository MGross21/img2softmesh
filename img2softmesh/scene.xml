<mujoco model="img2softmesh-{name}">
  <!-- generated by img2softmesh; kind={kind} -->
  <option timestep="0.002" solver="CG" tolerance="1e-3" integrator="discrete"/>
  <size memory="256M"/>
  <visual>
    <headlight ambient=".45 .45 .45" diffuse=".55 .55 .55" specular="0 0 0"/>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <equality active="false"/>
    <default class="gripper">
      <geom type="sphere" size="{grip_r}" rgba="1 .35 .2 1" contype="0" conaffinity="0"/>
    </default>
  </default>

  <asset>
    <texture name="cloth" type="2d" file="texture.png"/>
    <material name="cloth" texture="cloth" specular="0" shininess="0"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".32 .34 .36" rgb2=".26 .28 .30" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8"/>
  </asset>

  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1" directional="true" diffuse=".4 .4 .4"/>
    <geom name="floor" type="plane" size="0 0 .05" material="grid"/>
    <geom name="table" type="box" pos="0 0 {table_hz}" size="{table_hx} {table_hy} {table_hz}" rgba=".62 .52 .42 1"/>

    <!-- scripted grippers: mocap bodies; grasp<g>_* equalities attach a patch of cloth vertices to gripper<g> -->
{grippers}

    <!-- cloth: vertex bodies are named cloth_<i>; contact shell is 2 * radius thick.
         The flex is hidden in group 3 and drawn by the skin below. -->
    <flexcomp name="cloth" type="mesh" file="cloth.obj" dim="2" radius="{radius}" mass="{mass}" group="3">
      <edge equality="{edge_eq}" damping="{damping}"/>
      <elasticity young="{young}" poisson="{poisson}" thickness="{thickness}" damping="{damping}"
                  elastic2d="{elastic2d}"/>
      <contact selfcollide="{selfcollide}" condim="3" friction="0.9" solref="0.004 1"/>
    </flexcomp>
  </worldbody>

  <!-- render mesh with a front|back texture atlas; inflate gives it the contact shell's thickness -->
  <deformable>
    <skin name="cloth" file="cloth.skn" material="cloth" inflate="{radius}"/>
  </deformable>

  <equality>
{grasp}
  </equality>
</mujoco>
